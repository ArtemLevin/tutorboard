{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/completion.schema.json",
  "title": "Completion gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptance_criteria_satisfied",
    "required_checks_passed",
    "blocking_review_findings",
    "unrelated_diff",
    "documentation_updated_if_needed",
    "invariants_verified",
    "contract_changes_documented",
    "migration_verified_if_required",
    "recovery_verified_if_required",
    "unresolved_assumptions",
    "residual_risks_disclosed"
  ],
  "properties": {
    "acceptance_criteria_satisfied": {
      "type": "boolean"
    },
    "required_checks_passed": {
      "type": "boolean"
    },
    "blocking_review_findings": {
      "type": "integer",
      "minimum": 0
    },
    "unrelated_diff": {
      "type": "boolean"
    },
    "documentation_updated_if_needed": {
      "type": "boolean"
    },
    "invariants_verified": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]+-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "contract_changes_documented": {
      "type": "boolean"
    },
    "migration_verified_if_required": {
      "type": "boolean"
    },
    "recovery_verified_if_required": {
      "type": "boolean"
    },
    "unresolved_assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "residual_risks_disclosed": {
      "type": "boolean"
    },
    "skipped_checks": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  }
}
