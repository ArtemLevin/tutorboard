{
  "name": "tutorboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"tools/**/*.{html,js,mjs,ts}\" \"*.{html,js,json,mjs,ts}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"tools/**/*.{html,js,mjs,ts}\" \"*.{html,js,json,mjs,ts}\" \".github/**/*.yml\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "performance": "vitest run tests/performance/board-performance.test.ts",
    "spike:smart-ink": "vitest run tests/unit/modules/smart-ink-spike --reporter=verbose --disableConsoleIntercept",
    "smart-ink:calibrate": "node scripts/calibrate-smart-ink-corpus.mjs",
    "smart-ink:corpus:hds": "node scripts/import-hds-corpus.mjs",
    "smart-ink:corpus:quickdraw": "node scripts/import-quickdraw-corpus.mjs",
    "test:watch": "vitest",
    "architecture": "node scripts/check-architecture.mjs",
    "e2e": "playwright test",
    "check": "npm run geometryos:check && npm run board-contract:check && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run performance && npm run architecture && npm run build",
    "board-contract:generate": "node scripts/generate-board-contract.mjs",
    "board-contract:check": "node scripts/check-board-contract.mjs",
    "geometryos:vendor": "node scripts/vendor-geometryos-contract.mjs",
    "geometryos:generate": "node scripts/generate-geometryos-contract.mjs",
    "geometryos:check": "node scripts/check-geometryos-contract.mjs",
    "geometryos:validator-smoke": "node scripts/check-geometryos-validator-runtime.mjs",
    "geometryos:live-smoke": "node scripts/geometryos-live-contract-smoke.mjs",
    "geometryos:live-browser": "playwright test --config playwright.geometryos.config.mjs"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "dompurify": "3.4.12",
    "konva": "10.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.2.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "ajv": "8.17.1",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "pngjs": "7.0.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
