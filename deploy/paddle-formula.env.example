# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
PADDLE_FORMULA_API_TOKEN=replace-with-a-long-random-token

# Fast default for school formulas.
PADDLE_FORMULA_MODEL=PP-FormulaNet-S
PADDLE_FORMULA_CPU_THREADS=8
PADDLE_FORMULA_ENABLE_HPI=false
PADDLE_FORMULA_ENABLE_MKLDNN=true
PADDLE_PDX_MODEL_SOURCE=BOS

# GPU override defaults. Keep TensorRT disabled for the first deployment.
PADDLE_FORMULA_PRECISION=fp32
PADDLE_FORMULA_USE_TENSORRT=false
