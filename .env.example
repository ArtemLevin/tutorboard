# Public build-time configuration only. Never put tokens or secrets in VITE_*.
VITE_APP_STAGE=development
# Optional local override. Production defaults to /api/v1/geometryos/.
VITE_GEOMETRYOS_BASE_URL=
VITE_FEATURE_DEV_DIAGNOSTICS=true
VITE_FEATURE_DOCUMENT_SNAPSHOTS=true
VITE_FEATURE_GEOMETRY_PROMPT=true
VITE_FEATURE_SERVER_SYNC=false
VITE_FEATURE_SMART_INK_DIAGNOSTICS=true
VITE_BOARD_API_BASE_URL=/api/v1
